generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

enum MembershipRole {
  owner
  admin
  member

  @@schema("public")
}

enum UserStatus {
  active
  invited
  suspended

  @@schema("public")
}

model Lead {
  id                 String    @id @default(cuid())
  nombre             String?
  empresa            String?
  email              String?
  rubro              String?
  empleados          String?
  codigoPais         String?
  telefono           String?
  telefonoCompleto   String?
  facturacionAnual   String?
  problema           String
  objetivo           String
  diagnostico        String
  diagnosticoResumen String?
  leadScore          Int       @default(0)
  leadLevel          String    @default("Frío")
  emailStatus        String?
  emailError         String?
  aceptaTerminos     Boolean   @default(false)
  fechaAceptacion    DateTime?
  humanVerified      Boolean   @default(false)
  isUnlocked         Boolean   @default(false)
  unlockedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  estadoComercial    String    @default("Nuevo")
  notasInternas      String?

  @@schema("public")
}

model User {
  id              String             @id @default(cuid())
  email           String             @unique
  fullName        String?
  passwordHash    String?
  status          UserStatus         @default(active)
  emailVerifiedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  memberships     TenantMembership[]

  @@index([email])
  @@schema("public")
}

model rrhh_processes {
  id         String   @id
  tenant_id  String
  user_id    String
  input      Json
  output     Json?
  created_at DateTime
  updated_at DateTime

  @@schema("public")
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents   TenantDocument[]
  analyses    TenantAnalysis[]
  memberships TenantMembership[]

  @@schema("public")
}

model TenantMembership {
  id        String         @id @default(cuid())
  tenantId   String
  userId     String
  role      MembershipRole @default(member)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@schema("public")
}

model TenantDocument {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    String
  title       String
  description String
  status      String
  source      String
  fileUrl     String?
  fileName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, category])
  @@map("tenant_documents")
  @@schema("public")
}

model TenantAnalysis {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mode          String
  summary       String
  risks         String[]
  opportunities String[]
  priority      String?
  globalScore   Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rawData       Json?

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("tenant_analyses")
  @@schema("public")
}
