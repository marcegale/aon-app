generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

enum MembershipRole {
  owner
  admin
  member

  @@schema("public")
}

enum UserStatus {
  active
  invited
  suspended

  @@schema("public")
}

model Lead {
  id                 String    @id @default(cuid())
  nombre             String?
  empresa            String?
  email              String?
  rubro              String?
  empleados          String?
  codigoPais         String?
  telefono           String?
  telefonoCompleto   String?
  facturacionAnual   String?
  problema           String
  objetivo           String
  diagnostico        String
  diagnosticoResumen String?
  leadScore          Int       @default(0)
  leadLevel          String    @default("Frío")
  emailStatus        String?
  emailError         String?
  aceptaTerminos     Boolean   @default(false)
  fechaAceptacion    DateTime?
  humanVerified      Boolean   @default(false)
  isUnlocked         Boolean   @default(false)
  unlockedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  estadoComercial    String    @default("Nuevo")
  notasInternas      String?

  @@schema("public")
}

model User {
  id              String             @id @default(cuid())
  email           String             @unique
  fullName        String?
  passwordHash    String?
  status          UserStatus         @default(active)
  emailVerifiedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  memberships     TenantMembership[]

  @@index([email])
  @@schema("public")
}

model rrhh_processes {
  id         String   @id
  tenant_id  String
  user_id    String
  input      Json
  output     Json?
  created_at DateTime
  updated_at DateTime

  @@schema("public")
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents   TenantDocument[]
  analyses    TenantAnalysis[]
  memberships TenantMembership[]

  @@schema("public")
}

model TenantMembership {
  id        String         @id @default(cuid())
  tenantId   String
  userId     String
  role      MembershipRole @default(member)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@schema("public")
}

model TenantDocument {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    String
  title       String
  description String
  status      String
  source      String
  fileUrl     String?
  fileName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, category])
  @@map("tenant_documents")
  @@schema("public")
}

model TenantAnalysis {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mode          String
  summary       String
  risks         String[]
  opportunities String[]
  priority      String?
  globalScore   Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rawData       Json?

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("tenant_analyses")
  @@schema("public")
}

model RecruitingSearch {
  id                     String                   @id @default(cuid())
  tenantId               String
  createdById            String
  refCode                String                   @unique
  title                  String
  requestText            String
  status                 String                   @default("generating")
  monitoringStatus       String?
  area                   String?
  seniority              String?
  modality               String?
  location               String?
  jobProfileOutput       Json?
  idealCandidateOutput   Json?
  scoringCriteriaOutput  Json?
  publicationCopiesOutput Json?
  aiGenerationLog        Json?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  companyProfile         RecruitingCompanyProfile?
  attachments            RecruitingAttachment[]
  candidates             RecruitingCandidate[]

  @@index([tenantId])
  @@map("recruiting_searches")
  @@schema("public")
}

model RecruitingCompanyProfile {
  id           String           @id @default(cuid())
  searchId     String           @unique
  razonSocial  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  search       RecruitingSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@map("recruiting_company_profiles")
  @@schema("public")
}

model RecruitingAttachment {
  id        String           @id @default(cuid())
  searchId  String
  createdAt DateTime         @default(now())

  search    RecruitingSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@index([searchId])
  @@map("recruiting_attachments")
  @@schema("public")
}

model RecruitingCandidate {
  id             String           @id @default(cuid())
  searchId       String
  candidateCode  String?
  fullName       String?
  email          String?
  receivedAt     DateTime         @default(now())

  search         RecruitingSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@index([searchId])
  @@map("recruiting_candidates")
  @@schema("public")
}

model AgentRun {
  id        String   @id @default(cuid())
  agentId   String
  userId    String?
  tenantId  String?
  status    String
  input     Json?
  output    Json?
  tokens    Int?
  cost      Float?
  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([tenantId])
  @@map("agent_runs")
  @@schema("public")
}

model CharlieSession {
  id              String    @id @default(cuid())
  deviceKey       String
  openaiSessionId String?
  status          String    @default("active")
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([deviceKey])
  @@map("charlie_sessions")
  @@schema("public")
}

model CharlieDevice {
  id        String    @id @default(cuid())
  deviceKey String    @unique
  userName  String
  status    String    @default("active")
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([deviceKey])
  @@map("charlie_devices")
  @@schema("public")
}
